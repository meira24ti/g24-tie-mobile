<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF3E0"
    tools:context=".Message.tutorial.Tutorial3Fragment">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imageTutorial3"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_more"
            android:contentDescription="Ikon Tutorial Selesai"
            app:tint="#EF6C00" />

        <TextView
            android:id="@+id/tvTitle3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Kamu Sudah Siap!"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#E65100"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvDesc3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Sekarang kamu sudah mengetahui cara menggunakan fitur Message."
            android:textSize="16sp"
            android:textColor="#555555"
            android:gravity="center"
            android:lineSpacingExtra="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Tekan tombol kembali untuk mulai melihat daftar pesan."
            android:textSize="14sp"
            android:textColor="#EF6C00"
            android:gravity="center" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
