<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF8FF">

    <!-- TOOLBAR -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="#6750A4"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:title="Widget Pertemuan 10"
        app:titleTextColor="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- AREA YANG BISA DI-SCROLL -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:padding="16dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- BAGIAN 1 -->
            <!-- TEXT INPUT LAYOUT DAN MATERIAL BUTTON -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. TextInputLayout &amp; MaterialButton"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#252525"
                android:layout_marginBottom="16dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textInputLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Email"
                app:startIconDrawable="@drawable/ic_edit"
                app:helperText="Masukkan alamat email yang valid"
                app:errorEnabled="true"
                app:counterEnabled="true"
                app:counterMaxLength="50">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:maxLength="50" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Login"
                android:textAllCaps="false"
                app:icon="@drawable/ic_login"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:cornerRadius="20dp"
                app:backgroundTint="#6750A4" />

            <!-- BAGIAN 2 -->
            <!-- CHIP DAN CHIP GROUP -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="2. Chip &amp; ChipGroup"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#252525" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupFilter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTerbaru"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Terbaru" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPenting"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Penting" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipBelumDibaca"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Belum Dibaca" />

            </com.google.android.material.chip.ChipGroup>

            <!-- BAGIAN 3 -->
            <!-- BACKGROUND DRAWABLE -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="3. Background dengan Drawable"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#252525" />

            <EditText
                android:id="@+id/etCatatan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="52dp"
                android:background="@drawable/edit_text_background"
                android:hint="Tulis catatan..."
                android:inputType="textCapSentences"
                android:singleLine="true"
                android:textSize="14sp" />

            <!-- BAGIAN 4 -->
            <!-- GRID LAYOUT -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="4. GridLayout"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#252525" />

            <androidx.gridlayout.widget.GridLayout
                android:id="@+id/gridMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:padding="8dp"
                app:columnCount="3"
                app:useDefaultMargins="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMenu1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Menu 1"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    app:layout_columnWeight="1"
                    app:layout_gravity="fill_horizontal" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMenu2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Menu 2"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    app:layout_columnWeight="1"
                    app:layout_gravity="fill_horizontal" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMenu3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Menu 3"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    app:layout_columnWeight="1"
                    app:layout_gravity="fill_horizontal" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMenu4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Menu 4"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    app:layout_columnWeight="1"
                    app:layout_gravity="fill_horizontal" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMenu5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Menu 5"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    app:layout_columnWeight="1"
                    app:layout_gravity="fill_horizontal" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMenu6"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Menu 6"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    app:layout_columnWeight="1"
                    app:layout_gravity="fill_horizontal" />

            </androidx.gridlayout.widget.GridLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
